{
  "name": "tetris-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepare": "",
    "harness:build": "esbuild harness/selfplay.ts --bundle --platform=node --format=esm --outfile=harness/dist/selfplay.mjs --log-level=warning",
    "harness": "npm run harness:build && node harness/dist/selfplay.mjs",
    "harness:typecheck": "tsc -p harness/tsconfig.json",
    "test:rules": "esbuild harness/rules.test.ts --bundle --platform=node --format=esm --outfile=harness/dist/rules.test.mjs --log-level=warning && node harness/dist/rules.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.21.5",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tensorflow/tfjs-layers": "^4.22.0"
  }
}
